name: Build Android APK

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  apk:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Install packages
        run: npm install --no-audit --no-fund

      - name: Prepare icons and chart library
        run: bash scripts/prepare-web.sh

      - name: Test the signal engine
        run: npm test

      - name: Create Android project
        run: npx cap add android

      - name: Allow notifications on Android 13 and later
        run: |
          M=android/app/src/main/AndroidManifest.xml
          grep -q POST_NOTIFICATIONS "$M" || sed -i 's#</manifest>#    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />\n</manifest>#' "$M"

      - name: Make app icons
        run: npm run android:icons
        continue-on-error: true

      - name: Copy the web app into Android
        run: npx cap sync android

      - name: Build APK
        working-directory: android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon

      - name: Rename APK
        run: cp android/app/build/outputs/apk/debug/app-debug.apk SynthScope.apk

      - uses: actions/upload-artifact@v4
        with:
          name: SynthScope-apk
          path: SynthScope.apk

      - name: Publish download
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v1.0.${{ github.run_number }}
          name: SynthScope 1.0.${{ github.run_number }}
          body: Download SynthScope.apk below on your Android phone, then open it to install.
          files: SynthScope.apk
          make_latest: true
